{{- /*
  Netlify _redirects, generated at build time. First match wins, so specific rules come first.
  Sources: data/redirects.yaml (hand-written legacy URLs) + generic rules for every page below.
*/ -}}
# Generated by layouts/home.redirects from data/redirects.yaml. Do not edit public/_redirects.

# Legacy URLs
{{ range hugo.Data.redirects.legacy -}}
{{ .from }}  {{ .to }}  {{ .status | default 301 }}{{ if .force }}!{{ end }}
{{ end }}
# Page 1 of every paginated list is the list itself (real 301s instead of Hugo's meta-refresh aliases)
{{ range where site.Pages "Kind" "in" (slice "home" "section" "taxonomy" "term") -}}
{{ .RelPermalink }}page/1/  {{ .RelPermalink }}  301
{{ end }}
# The old site served every page at <path>.html too
{{ range site.Pages -}}
{{ if and (strings.HasSuffix .RelPermalink "/") (ne .RelPermalink "/") -}}
{{ strings.TrimSuffix "/" .RelPermalink }}.html  {{ .RelPermalink }}  301
{{ end -}}
{{ end }}
# Front-matter `aliases` (renamed pages)
{{ range $p := site.Pages }}{{ range $p.Aliases -}}
{{ . }}  {{ $p.RelPermalink }}  301
{{ end }}{{ end -}}
